# Copy to .env and fill in. Never commit .env.
PORT=3001
CORS_ORIGIN=http://localhost:5173
# Optional: when set, ops endpoints (GET /api/voice/stats) require x-api-key.
API_KEY=

# DB_PROVIDER=sqlite | mysql
DB_PROVIDER=sqlite
SQLITE_PATH=./data/voice-commerce.db
# MySQL (used when DB_PROVIDER=mysql, e.g. via docker-compose)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=voice
MYSQL_PASSWORD=voice
MYSQL_DATABASE=voice_commerce

# LLM. Optional — keyword fallback works without a key.
# Selection: explicit LLM_PROVIDER wins (groq|gemini); otherwise Groq when
# GROQ_API_KEY is set, Gemini when GOOGLE_API_KEY is set.
LLM_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Phase 4 (voice). Defaults: browser STT + browser TTS, no keys needed.
STT_PROVIDER=
# STT_PROVIDER=deepgram | whisper (needs key below)
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
TTS_PROVIDER=browser
# TTS_PROVIDER=elevenlabs (needs keys below)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Phase 6 (real Shopify). Leave empty to use mock provider.
SHOPIFY_STORE_URL=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2024-10
